# === Локальный go run: скопируйте в .env ===
# === Docker compose: в .env в этой папке достаточно OPENAI_API_KEY= (DB_HOST в compose задан для сервиса api) ===
PORT=8080
DB_HOST=localhost
DB_PORT=5434
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=marketplace
JWT_SECRET=your-super-secret-jwt-key-at-least-32-chars
JWT_EXPIRE_HOURS=24
AES_KEY=0123456789abcdef0123456789abcdef
S3_ENDPOINT=localhost:9002
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=marketplace
S3_USE_SSL=false

# RAG + career LLM (без ключа RAG и эмбеддинги отключены)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
